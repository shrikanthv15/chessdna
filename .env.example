# ChessDNA environment configuration.
# Copy to backend/.env (backend loads it) and fill in values.

# --- LLM Coach (OpenAI-compatible provider adapter) ---
# Works with Ollama Cloud, local Ollama, OpenAI, or LiteLLM.
# Leave LLM_API_KEY empty to use the built-in rule-based coaching templates.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=gpt-oss:120b

# --- Chess engine ---
# Absolute path to the Stockfish binary. setup_stockfish.sh resolves this for you.
STOCKFISH_PATH=

# --- Analysis defaults ---
ENGINE_DEPTH=12
# Parallel game workers, one Stockfish process each (Threads=1). Set to the
# box's core count; jobs queue one at a time so workers never oversubscribe.
ANALYZE_WORKERS=2
# Lichess cloud eval first tier (disk-cached under data/cache/cloud_eval/).
# Any failure falls back silently to local Stockfish. Set to false to
# disable all cloud requests.
CLOUD_EVAL_ENABLED=true
# Cloud eval is only consulted within the first N half-moves (openings,
# where the Lichess database is deep); later positions go straight to
# local Stockfish so cold runs don't pay an HTTP round-trip per position.
CLOUD_EVAL_MAX_PLY=24

# --- CORS ---
# Comma-separated origins allowed to call the API. Include the deployed
# frontend origin in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
